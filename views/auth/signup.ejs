<%- include("../partials/head.ejs", {title: "Sign Up"}) %>
</head>

<body class="bg-gray-100 text-gray-900 font-sans">
    <%- include("../partials/navbar.ejs") %>


    <div class="flex flex-col items-center mt-10 mb-16">
        <header class="mb-8 text-center">
            <h1 class="text-4xl font-bold text-red-500">
                Sign Up for Airbnb
            </h1>
            <p class="text-gray-600 mt-2">Join us to find your perfect stay or host one!</p>
        </header>
        
        <main class="w-full max-w-lg bg-white p-8 rounded-lg shadow-md border border-gray-200">
            <form action="/signup" method="POST" class="flex flex-col space-y-5">
                
                <!-- Inline Error Box -->
                <% if (locals.errors && locals.errors.length > 0) { %>
                    <div id="errorBox" class="bg-red-50 border border-red-400 p-3 relative rounded text-red-600">
                        <button type="button" onclick="document.getElementById('errorBox').style.display='none'" class="absolute top-3 right-3 text-red-600 hover:text-red-800 font-bold text-lg leading-none focus:outline-none cursor-pointer">
                            &times;
                        </button>
                        <h3 class="font-bold mb-1 text-red-600">Error!</h3>
                        <ul class="list-disc list-inside text-sm space-y-0.5">
                            <% errors.forEach(error => { %>
                                <li><%= error.msg %></li>
                            <% }) %>
                        </ul>
                    </div>
                <% } %>
                
                <!-- Name Fields -->
                <div class="flex space-x-4">
                    <div class="flex flex-col space-y-1 w-1/2">
                        <label class="font-medium text-gray-700">First Name:</label>
                        <input type="text" name="firstName" placeholder="First Name" value="<%= locals.firstName || '' %>"
                            class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500"
                            >
                    </div>
                    <div class="flex flex-col space-y-1 w-1/2">
                        <label class="font-medium text-gray-700">Last Name:</label>
                        <input type="text" name="lastName" placeholder="Last Name" value="<%= locals.lastName || '' %>"
                            class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500"
                            >
                    </div>
                </div>

                <!-- Email Field -->
                <div class="flex flex-col space-y-1">
                    <label class="font-medium text-gray-700">Email:</label>
                    <input type="email" name="email" placeholder="Enter your email" value="<%= locals.email || '' %>"
                        class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500"
                        >
                </div>

                <!-- Password Fields -->
                <div class="flex flex-col space-y-1">
                    <label class="font-medium text-gray-700">Password:</label>
                    <input type="password" name="password" placeholder="Create a password"
                        class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500"
                        >
                </div>

                <div class="flex flex-col space-y-1">
                    <label class="font-medium text-gray-700">Confirm Password:</label>
                    <input type="password" name="confirmPassword" placeholder="Confirm your password"
                        class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500"
                        >
                </div>

                <!-- User Type (Radio Buttons) -->
                <div class="flex flex-col space-y-2 pt-2 border-t border-gray-100">
                    <label class="font-medium text-gray-700">I want to join as a:</label>
                    <div class="flex items-center space-x-6">
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input type="radio" name="userType" value="guest" class="text-red-500 focus:ring-red-500" <%= (!locals.userType || locals.userType === 'guest') ? 'checked' : '' %>>
                            <span class="text-gray-700">Guest</span>
                        </label>
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input type="radio" name="userType" value="host" class="text-red-500 focus:ring-red-500" <%= (locals.userType === 'host') ? 'checked' : '' %>>
                            <span class="text-gray-700">Host</span>
                        </label>
                    </div>
                </div>

                <!-- Terms and Conditions Checkbox -->
                <div class="flex items-start pt-3 mb-4">
                    <div class="flex items-center h-5">
                        <input id="terms" name="terms" type="checkbox" required
                            class="w-4 h-4 border border-gray-300 rounded bg-gray-50 focus:ring-3 focus:ring-red-300 text-red-500">
                    </div>
                    <label for="terms" class="ml-2 text-sm font-medium text-gray-900 ">
                        I agree with the <a href="#" class="text-red-600 hover:underline">terms and conditions</a>.
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit"
                    class="bg-red-500 text-white font-bold rounded-lg py-5 text-lg cursor-pointer hover:bg-red-600 mt-3 shadow-md transition duration-300">
                    Create Account
                </button>
                
                <p class="text-sm text-center text-gray-600 mt-4">
                    Already have an account? <a href="/login" class="text-red-500 hover:underline font-medium">Log in</a>
                </p>
            </form>
        </main>
    </div>
</body>
</html>
