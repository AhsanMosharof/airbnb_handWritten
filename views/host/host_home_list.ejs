<%- include("../partials/head.ejs",{title:"airbnb home"}) %>
    </head>

    <body class="bg-gray-100 text-gray-900 font-sans">
        <%- include("../partials/navbar.ejs") %>

            <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
                <h1 class="text-4xl font-bold text-gray-800 mb-6">Welcome to Airbnb Host Home List</h1>
                <p class="text-lg text-gray-600 mb-8">Find your next perfect stay or host your own home.</p>
                <a href="/host/addHome"
                    class="inline-block px-6 py-3 bg-red-500 text-white font-semibold rounded-lg shadow-md hover:bg-red-600 transition duration-300">Add
                    a New Home</a>

                <div class="mt-16">
                    <h2 class="text-3xl font-bold text-gray-800 mb-8 border-b pb-2">Registered Homes</h2>

                    <% if (registerdHome.length> 0) { %>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                            <% registerdHome.forEach((home)=> { %>
                                <div class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden group">
                                    <!-- Image Container with Fallback -->
                                    <div class="relative h-64 overflow-hidden">
                                        <img src="<%= home.imageUrl ? home.imageUrl : 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80' %>" 
                                             alt="<%= home.name %>" 
                                             class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500">
                                        
                                        <!-- Price Badge -->
                                        <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-4 py-2 rounded-full shadow-lg font-bold text-gray-900">
                                            $<%= home.price %> <span class="text-sm font-normal text-gray-600">/ night</span>
                                        </div>

                                        <!-- Rating Badge -->
                                        <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full shadow-lg flex items-center space-x-1">
                                            <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                            </svg>
                                            <span class="font-semibold text-sm text-gray-800"><%= home.rating %></span>
                                        </div>
                                    </div>
                                    
                                    <!-- Content -->
                                    <div class="p-6">
                                        <h3 class="text-2xl font-bold text-gray-900 mb-2 capitalize truncate"><%= home.name %></h3>
                                        
                                        <div class="flex items-center text-gray-600 mb-4">
                                            <svg class="w-5 h-5 mr-2 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            </svg>
                                            <span class="truncate"><%= home.location %></span>
                                        </div>
                                        
                                        <p class="text-gray-600 line-clamp-2 mb-6"><%= home.house %></p>
                                        
                                        <!-- Actions -->
                                        <div class="mt-6 flex space-x-4">
                                            <a href="/host/edit-home/<%= home._id %>?editing=true"
                                                class="flex-1 block text-center bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold py-2.5 px-4 rounded-xl transition duration-300">
                                                Edit
                                            </a>
                                            <form action="/host/delete-home" method="POST" class="flex-1">
                                                <input type="hidden" name="id" value="<%=home._id%>">
                                                <button type="submit"
                                                    class="w-full block text-center bg-red-500 hover:bg-red-600 text-white font-semibold py-2.5 px-4 rounded-xl shadow-md transition duration-300">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                        <% } else { %>
                            <div class="bg-gray-50 border-l-4 border-red-400 p-6 rounded-r-lg shadow-sm">
                                <p class="text-gray-600 italic text-lg">No homes registered yet. Be the first to add
                                    one!</p>
                            </div>
                            <% } %>
                </div>


            </main>
    </body>

    </html>