<%- include("../partials/head.ejs",{title})%>
    </head>

    <body class="bg-gray-100 text-gray-900 font-sans">

        <%- include("../partials/navbar.ejs")%>



            <div class="flex flex-col items-center mt-10">
                <header class="mb-8 text-center">
                    <h1 class="text-4xl font-bold text-blue-600">
                        <%= editing ? "Edit your" : "Add new" %> Home to Airbnb
                    </h1>
                </header>
                <main class="w-full max-w-md bg-white p-6 rounded-lg shadow-md">
                    <form action="<%= editing ? `/host/edit-home` : `/host/addHome`%>" method="POST" enctype="multipart/form-data" class="flex flex-col space-y-4">
                        <% if (editing) { %>
                            <input type="hidden" name="id" value="<%= home._id %>">
                            <% } %>

                                <div class="flex flex-col space-y-1">
                                    <label class="font-medium text-gray-700">Name:</label>
                                    <input type="text" name="name" placeholder="Enter your name"
                                        value="<%= editing ? home.name : "" %>"
                                        class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-blue-500"
                                        required>
                                </div>

                                <div class="flex flex-col space-y-1">
                                    <label class="font-medium text-gray-700">House Address:</label>
                                    <input type="text" name="house" placeholder="Enter your house address"
                                        value="<%= editing ? home.house : "" %>"
                                        class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-blue-500"
                                        required>
                                </div>

                                <div class="flex flex-col space-y-1">
                                    <label class="font-medium text-gray-700">Price:</label>
                                    <input type="number" name="price" placeholder="Enter price"
                                        value="<%= editing ? home.price : "" %>"
                                        class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-blue-500"
                                        required>
                                </div>

                                <div class="flex flex-col space-y-1">
                                    <label class="font-medium text-gray-700">Location:</label>
                                    <input type="text" name="location" placeholder="Enter location"
                                        value="<%= editing ? home.location : "" %>"
                                        class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-blue-500"
                                        required>
                                </div>

                                <div class="flex flex-col space-y-1">
                                    <label class="font-medium text-gray-700">Rating:</label>
                                    <input type="number" step="0.1" name="rating" placeholder="Enter rating"
                                        value="<%= editing ? home.rating : "" %>"
                                        class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-blue-500"
                                        required>
                                </div>

                                <div class="flex flex-col space-y-1">
                                    <label class="font-medium text-gray-700">Image:</label>
                                    <input type="file" name="image" accept="image/*"
                                        class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-blue-500"
                                        <%= editing ? "" : "required" %>>
                                </div>

                                <button type="submit"
                                    class="bg-blue-600 text-white font-semibold rounded py-2 hover:bg-blue-700 transition duration-300">
                                    <%=editing?"Update Home":"Add Home"%>
                                </button>
                    </form>
                </main>
            </div>
    </body>

    </html>