<%- include("../partials/head.ejs",{title:"Airbnb - Home Details"}) %>
</head>
<body class="bg-gray-100 text-gray-900 font-sans">
   <%- include("../partials/navbar.ejs") %>

   <main class="min-h-screen bg-white p-4 sm:p-8">
     <% if (home) { %>
         <div class="max-w-5xl mx-auto mt-4">
             <!-- Header -->
             <div class="text-center mb-10">
                 <h1 class="text-3xl font-bold text-red-500">Details of <%= home.name %></h1>
             </div>

             <!-- Two Column Layout -->
             <div class="flex flex-row gap-6 md:gap-10 items-start w-full">
                 
                 <!-- Left Column: Image -->
                 <div class="w-[50%]">
                     <img src="<%= home.imageUrl %>" 
                          alt="<%= home.name %>" 
                          class="w-full h-auto object-cover rounded-lg shadow-sm">
                 </div>

                 <!-- Right Column: Details -->
                 <div class="w-[50%] flex flex-col">
                     
                     <!-- Description -->
                     <div class="border-b border-gray-200 pb-5 mb-5">
                         <h3 class="text-xl font-bold text-gray-900 mb-2">Description</h3>
                         <p class="text-gray-600"><%= home.house %></p>
                     </div>

                     <!-- Location -->
                     <div class="border-b border-gray-200 pb-5 mb-5">
                         <h3 class="text-xl font-bold text-gray-900 mb-2">Location</h3>
                         <p class="text-gray-600"><%= home.location %></p>
                     </div>

                     <!-- Price -->
                     <div class="border-b border-gray-200 pb-5 mb-5">
                         <h3 class="text-xl font-bold text-gray-900 mb-2">Price</h3>
                         <p class="text-green-600 font-bold text-lg">$<%= home.price %> <span class="text-green-600 text-base font-semibold">/ night</span></p>
                     </div>

                     <!-- Rating -->
                     <div class="border-b border-gray-200 pb-5 mb-5">
                         <h3 class="text-xl font-bold text-gray-900 mb-2">Rating</h3>
                         <p class="text-gray-900 font-medium flex items-center">
                             <svg class="w-5 h-5 text-yellow-400 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                             <%= home.rating %> / 5
                         </p>
                     </div>
                     
                     <!-- Actions -->
                     <div class="flex gap-4 pt-2">
                         <a href="/home" class="inline-flex justify-center items-center px-6 py-2.5 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                             Back to Listings
                         </a>
                        <%- include("../partials/fav.ejs",{home:home}) %>
                     </div>

                 </div>
             </div>
         </div>
     <% } else { %>
         <div class="max-w-md mx-auto mt-20 text-center">
             <h3 class="text-2xl font-bold text-gray-900 mb-2">Home Not Found</h3>
             <p class="text-gray-600 mb-6">The home you are looking for does not exist.</p>
             <a href="/home" class="text-indigo-600 hover:text-indigo-500 font-medium">
                 &larr; Back to Listings
             </a>
         </div>
     <% } %>
   </main>
</body>
</html>
